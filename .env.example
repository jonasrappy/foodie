# Generate your own credentials: make build && ./bin/foodie init
# This template deliberately contains no usable credentials.
FOODIE_PASSWORD=
FOODIE_PASSWORD_SALT=
FOODIE_SESSION_SECRET=
FOODIE_BOT_TOKEN=
# Existing installations can use hashes instead of plaintext values above.
# FOODIE_PASSWORD_HASH=
# FOODIE_BOT_TOKEN_HASH=

# English is the default for UI, voice recognition and TTS. Use da for Danish.
FOODIE_LANGUAGE=en
FOODIE_TIMEZONE=UTC
FOODIE_LISTEN=127.0.0.1:8082
FOODIE_DATA_DIR=./data
FOODIE_PUBLIC_DIR=./public
FOODIE_SITE_URL=https://foodie.example.com

# Android build settings. Passwords/tokens are NEVER embedded in the APK.
ANDROID_APPLICATION_ID=app.foodie.mobile
ANDROID_SDK_ROOT=
ANDROID_SIGN_DIR=./.private/android-signing
ANDROID_KEY_ALIAS=foodie
ANDROID_VERSION_NAME=1.4.0
ANDROID_VERSION_CODE=9
